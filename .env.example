# Ключи доступа к внешним API для скиллов агента.
#
# КАК ПОЛЬЗОВАТЬСЯ
#   1) скопировать этот файл в marketing-agents/.env
#   2) вписать значения после знака =
#   3) файл .env в репозиторий НЕ попадает (см. .gitignore), сюда — только имена переменных
#
# Рантайм читает .env автоматически (skills/runtime/core.py: load_env_file).
# Реальные значения переменных окружения ИМЕЮТ ПРИОРИТЕТ над .env.
#
# Если ключ не задан, скилл не падает: он пишет предупреждение в лог
# (skills/logs/skill-runs.jsonl) и возвращает пустой список.

# --- Скиллы, работающие без ключа (для полноты картины) -----------------------
# mcp_market     — MCP Market Russia: ключ не нужен
# mcp_rosreestr  — локальный MCP-сервер Росреестра: ключ не нужен,
#                  но нужна машина с российским IP и поднятый сервер
#                  (см. MCP_ROSREESTR_URL ниже)
# rentscout      — локально развёрнутый сервис: ключ не нужен,
#                  но развёртывание НЕ выполнено (см. RENTSCOUT_URL ниже)

# --- 1. ReefAPI (Avito / Cian) ------------------------------------------------
# Бесплатно 1 000 кредитов при регистрации, карта не нужна.
# Где взять: https://reefapi.com/signup
# Авторизация: заголовок x-api-key. Без ключа скилл вернёт пустой список.
REEFAPI_KEY=
# Какое API ReefAPI опрашивать по умолчанию: avito | cian
REEFAPI_API=avito

# --- 2. Apify (Free Tier) -----------------------------------------------------
# Бесплатно $5 кредитов ежемесячно. Где взять: https://console.apify.com/account/integrations
# Без токена скилл вернёт пустой список.
APIFY_TOKEN=
# Идентификатор готового актора, например "drobnikj/crawler-google-places".
# Без него скилл отвечает «сервис не развёрнут» и объясняет, что задать.
APIFY_ACTOR=

# --- 3. RentCast (рынок США) --------------------------------------------------
# Бесплатно 50 запросов в месяц. Где взять: https://app.rentcast.io/app/api
# ВНИМАНИЕ: только рынок США, к новостройкам Москвы неприменимо.
RENTCAST_KEY=
RENTCAST_BASE_URL=https://api.rentcast.io/v1

# --- 4. Zillapi (данные Zillow, рынок США) ------------------------------------
# Бесплатно 100 кредитов без кредитной карты. Где взять: https://zillapi.com/signup
# Авторизация: заголовок Authorization: Bearer zk_...
# ВНИМАНИЕ: только рынок США (Zillow).
ZILLAPI_KEY=
ZILLAPI_BASE_URL=https://api.zillapi.com

# --- 5. Яндекс Директ API v5 и Метрика (Агент 2) ------------------------------
# ОСНОВНОЙ токен доступа. Один OAuth-токен на Директ и Метрику.
# Где взять: приложение в https://oauth.yandex.ru/ (тип «Для доступа к API или отладки»,
# доступ «Яндекс Директ» direct:api), затем токен со страницы подтверждения.
# Без токена запросы НЕ выполняются: скилл вернёт skipped_no_key и пустой список.
YANDEX_OAUTH_TOKEN=
# Устаревшее имя переменной: читается как запасной вариант, если YANDEX_OAUTH_TOKEN пуст.
YANDEX_DIRECT_TOKEN=
# Логин клиента для агентских аккаунтов (заголовок Client-Login). Свой аккаунт — оставить пустым.
YANDEX_DIRECT_CLIENT_LOGIN=
# 1 — работать с песочницей api-sandbox.direct.yandex.com (безопасные тесты), иначе продакшен.
YANDEX_DIRECT_SANDBOX=

# Номер счётчика Метрики: по нему читаются цели и конверсии.
# Запросы к Метрике идут с заголовком Authorization: OAuth <токен> (не Bearer).
YANDEX_METRICA_COUNTER_ID=
# Необязательный отдельный токен Метрики; пусто — берётся YANDEX_OAUTH_TOKEN.
YANDEX_METRICA_TOKEN=

# --- Необязательные адреса локальных сервисов ---------------------------------

# RentScout: локальный сервис агрегации аренды. По умолчанию http://127.0.0.1:8000
# Развёртывание не выполнено — скилл сообщит об этом с пояснением.
RENTSCOUT_URL=http://127.0.0.1:8000
# Список источников через запятую (уточняется при развёртывании)
RENTSCOUT_SOURCES=avito,cian,domofond,yandex,domclick

# mcp-rosreestr: локальный MCP-сервер Росреестра/НСПД.
# Нужна машина с российским IP. Если URL не задан, скилл скажет, что сервер не поднят.
MCP_ROSREESTR_URL=
